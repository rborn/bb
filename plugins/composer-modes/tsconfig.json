{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "paths": {
      "@get-bb/plugin-sdk": ["../../packages/plugin-sdk/bundled-types/bb-plugin-sdk.d.ts"],
      "@get-bb/plugin-sdk/app": ["../../packages/plugin-sdk/bundled-types/bb-plugin-sdk-app.d.ts"]
    }
  },
  "include": ["*.ts", "*.tsx", "app.tsx"]
}
